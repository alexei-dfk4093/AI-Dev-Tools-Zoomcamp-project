# EcoMind configuration. Copy this file to `.env` at the project root and
# fill in the values. Never commit the real `.env` file.

# Required. News provider key. A 40-character token selects MarketAux,
# any other value selects NewsAPI.
NEWS_API_KEY=

# Optional but recommended. Enables AI summaries, article analysis, and
# discussions via OpenRouter. Without it the app shows publisher
# descriptions and explicit configuration errors instead of AI output.
OPENROUTER_API_KEY=

# Optional. Defaults to OpenRouter's "openrouter/free" router. To pin a
# specific zero-cost model, use its exact ":free" ID from OpenRouter's
# catalog; paid model IDs are ignored.
# OPENROUTER_MODEL=openrouter/free

# Optional. Comma-separated list of allowed free models for the discussion
# composer. Paid IDs are ignored.
# OPENROUTER_MODELS=openrouter/free

# Optional news-feed settings (defaults shown).
# NEWS_REFRESH_INTERVAL_SECONDS=1800
# ARTICLE_CONTENT_FETCH_ENABLED=true
# ARTICLE_CONTENT_FETCH_CONCURRENCY=5
# ARTICLE_CONTENT_FETCH_PER_CYCLE=12
# ARTICLE_READER_PROXY_URL=
# OPENROUTER_WEB_TOOLS_ENABLED=true
# OPENROUTER_DAILY_CALL_BUDGET=40
